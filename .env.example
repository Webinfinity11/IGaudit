# საიტის საბოლოო მისამართი (canonical, sitemap, Open Graph)
VITE_SITE_URL=https://igaudit.ge

# ინგლისური ვერსია: false - LangSwitcher იმალება და /en გვერდები არ იქმნება
VITE_ENABLE_EN=true

# ფორმა: ნაგულისხმევად /api/contact (SMTP). Web3Forms-ისთვის - endpoint + key
VITE_FORM_ENDPOINT=
VITE_FORM_KEY=

# Cloudflare Turnstile - ცარიელისას captcha არ ჩანს (ლოკალური დეველოპმენტი)
VITE_TURNSTILE_SITE_KEY=

# Google Analytics 4 - იტვირთება მხოლოდ cookie-თანხმობის შემდეგ
VITE_GA_ID=

# api/contact.ts (Vercel env, არა VITE_ - ბრაუზერში არ ხვდება)
SMTP_HOST=liberty.hosthp.net
SMTP_PORT=465
SMTP_USER=info@igaudit.ge
SMTP_PASS=
MAIL_TO=info@igaudit.ge
